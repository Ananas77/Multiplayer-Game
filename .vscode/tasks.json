{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build active file",
            "command": "/sbin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}/client/main.cpp",
                "${workspaceFolder}/client/shader.cpp",
                "${workspaceFolder}/client/camera.cpp",
                "${workspaceFolder}/client/lib/glad/glad.c",
                "-o",
                "${workspaceFolder}/client/main",
                "-lglfw",
                "-D_DEBUG"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}